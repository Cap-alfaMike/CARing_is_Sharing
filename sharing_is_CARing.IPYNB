# ============================================================
# Car-ing is Sharing - LLM Prototype (Corrigido: BLEU como Dict)
# ============================================================

import re
import torch
import pandas as pd
import evaluate

from transformers import pipeline, logging
from sklearn.metrics import accuracy_score, f1_score

logging.set_verbosity(logging.WARNING)

# ------------------------------------------------------------
# Device
# ------------------------------------------------------------
device = 0 if torch.cuda.is_available() else -1

# ------------------------------------------------------------
# Load Dataset
# ------------------------------------------------------------
car_reviews = pd.read_csv("data/car_reviews.csv", sep=";")

if list(car_reviews.columns) != ["review", "label"]:
    car_reviews.columns = ["review", "label"]

car_reviews["label"] = car_reviews["label"].astype(str).str.strip().str.upper()
car_reviews = car_reviews[car_reviews["label"].isin(["POSITIVE", "NEGATIVE"])].reset_index(drop=True)

# ============================================================
# 1. SENTIMENT ANALYSIS
# ============================================================
sentiment_pipeline = pipeline(
    "sentiment-analysis",
    model="distilbert-base-uncased-finetuned-sst-2-english",
    device=device
)

reviews = car_reviews["review"].astype(str).tolist()

with torch.inference_mode():
    predicted_labels = sentiment_pipeline(reviews, batch_size=len(reviews))

predictions = [1 if p["label"] == "POSITIVE" else 0 for p in predicted_labels]

true_labels = car_reviews["label"].map({"POSITIVE": 1, "NEGATIVE": 0}).tolist()

accuracy_result = accuracy_score(true_labels, predictions)
f1_result = f1_score(true_labels, predictions)

# ============================================================
# 2. TRANSLATION
# ============================================================
translator = pipeline(
    "translation_en_to_es",
    model="Helsinki-NLP/opus-mt-en-es",
    device=device
)

first_review = car_reviews.loc[0, "review"]
sentences = re.split(r'(?<=[.!?])\s+', first_review.strip())
first_two_sentences = " ".join(sentences[:2])

with torch.inference_mode():
    translated_review = translator(
        first_two_sentences,
        max_length=128,
        do_sample=False
    )[0]["translation_text"]

# ============================================================
# BLEU SCORE (Usando evaluate.load para retornar um dicionário)
# ============================================================
bleu_metric = evaluate.load("bleu")

# Ler as referências do arquivo
with open("data/reference_translations.txt", encoding="utf-8") as f:
    # Cada linha é uma referência válida para a mesma tradução
    references = [line.strip() for line in f if line.strip()]

# O método .compute() do evaluate espera:
# predictions: lista de strings
# references: lista de listas de strings (para suportar múltiplas referências por item)
bleu_score = bleu_metric.compute(
    predictions=[translated_review],
    references=[references]
)

# ============================================================
# 3. QUESTION ANSWERING
# ============================================================
qa_pipeline = pipeline(
    "question-answering",
    model="deepset/minilm-uncased-squad2",
    device=device
)

question = "What did he like about the brand?"
context = car_reviews.loc[1, "review"]

with torch.inference_mode():
    answer = qa_pipeline(
        question=question,
        context=context
    )["answer"]

# ============================================================
# 4. SUMMARIZATION AND BIAS ANALYSIS
# ============================================================
summarizer = pipeline(
    "summarization",
    model="facebook/bart-large-cnn",
    device=device
)

last_review = car_reviews.iloc[-1]["review"]

with torch.inference_mode():
    summarized_text = summarizer(
        last_review,
        min_new_tokens=50,
        max_new_tokens=55,
        num_beams=4,
        early_stopping=False,
        do_sample=False,
        length_penalty=2.0,
    )[0]["summary_text"]

# Análise de Viés: Toxicidade e Regard
toxicity_metric = evaluate.load("toxicity")
toxicity_scores = toxicity_metric.compute(predictions=[summarized_text])
max_toxicity = max(toxicity_scores["toxicity"])

regard_metric = evaluate.load("regard")
regard_scores = regard_metric.compute(data=[summarized_text])
max_regard = max([item['score'] for item in regard_scores['regard'][0]])

# ============================================================
# OUTPUT
# ============================================================
print("=" * 60)
print("Predicted labels:")
print(predicted_labels)

print("\nBinary predictions:")
print(predictions)

print("\nAccuracy:", accuracy_result)
print("F1 Score:", f1_result)

print("\nTranslated review:")
print(translated_review)

print("\nBLEU Score (Dictionary):")
print(bleu_score)
print("\nBLEU Score Value:", bleu_score["bleu"])

print("\nQuestion:")
print(question)

print("\nAnswer:")
print(answer)

print("\nSummary:")
print(summarized_text)

print("\nMax Toxicity:", max_toxicity)
print("Max Regard:", max_regard)
